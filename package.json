{
  "name": "hara",
  "version": "1.0.0",
  "private": true,
  "description": "Hara — aplikasi catatan & alat renamer. Dibungkus Capacitor untuk APK Android.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "cap:sync": "cap sync android",
    "preview": "node tools/preview.mjs",
    "test": "ls tools/uji/*.mjs | xargs -P ${JOBS:-4} -I {} bash -c 'node \"{}\" || exit 1'",
    "test:cepat": "grep -L jsdom tools/uji/*.mjs | xargs -P ${JOBS:-4} -I {} node {}",
    "test:ui": "grep -l jsdom tools/uji/*.mjs | xargs -P ${JOBS:-4} -I {} bash -c 'node \"{}\" || exit 1'"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capgo/capacitor-updater": "8.52.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
